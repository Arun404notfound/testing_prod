// Assessment demo — local SQLite MVP

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AssessmentType {
  KNOWLEDGE_MCQ
  LIKERT_PSYCHOMETRIC
  FORCED_CHOICE_TRIAD
  HYBRID
}

enum ItemType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  TRUE_FALSE
  LIKERT
  TRIAD
  SJT
  OPEN_ENDED
}

enum ModuleType {
  PSYCHOMETRIC
  TECHNICAL
  SURVEY
}

enum ProgramCompositionType {
  PSYCHOMETRIC
  TECHNICAL
  SURVEY
  MIXED
}

enum Polarity {
  POSITIVE
  NEGATIVE
}

enum AssignmentStatus {
  assigned
  completed
  cancelled
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  SCORED
  ABANDONED
}

enum ProctoringEventType {
  TAB_SWITCH
  FULLSCREEN_EXIT
}

enum ResponseStatus {
  ANSWERED
  SKIPPED
  FLAGGED
}

enum ImportType {
  CANDIDATES
  MCQ_QUESTIONS
  LIKERT_ITEMS
  TRIAD_ITEMS
  SJT_ITEMS
  CASE_STUDY_ITEMS
}

enum ImportJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AssessmentLifecycleStatus {
  draft
  published
}

enum ReportTemplateType {
  TECHNICAL_SKILLS_REPORT
  PSYCHOMETRIC_TRAIT_REPORT
  FORCED_CHOICE_REPORT
  HYBRID_REPORT
  SALES_PROFILER_REPORT
  SALES_SIMULATION_REPORT
  CUSTOM
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  logoUrl              String?
  primaryColor         String?
  secondaryColor       String?
  accentColor          String?
  disclaimerText       String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  candidates           Candidate[]
  assessments          Assessment[]
  questions            Question[]
  reportTemplates      ReportTemplate[]
  auditLogs            AuditLog[]
  importJobs           ImportJob[]
  triadGroups          TriadGroup[]
  caseStudies          CaseStudy[]
  users                User[]
  attributes           Attribute[]
  competencies         Competency[]
  bigFiveFactorConfigs BigFiveFactorConfig[]
  jobRoles             JobRole[]
  domains              Domain[]
  emailTemplates       EmailTemplate[]
  skills               Skill[]
  programs             Program[]
  skillFrameworks      SkillFramework[]
  skillDomains         SkillDomain[]
  skillCompetencies    SkillCompetency[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          UserRole
  tenantId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  passwordSetAt DateTime?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([role])
}

model Candidate {
  id                 String                 @id @default(cuid())
  tenantId           String?
  fullName           String
  email              String
  mobile             String
  employeeId         String
  designation        String
  department         String
  location           String
  batchName          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt
  tenant             Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assignments        AssessmentAssignment[]
  attempts           AssessmentAttempt[]
  results            AssessmentResult[]
  programAssignments ProgramAssignment[]
  programResults     ProgramResult[]

  @@index([tenantId])
  @@index([email])
  @@index([employeeId])
  @@index([batchName])
}

model Assessment {
  id                 String                      @id @default(cuid())
  tenantId           String?
  reportTemplateId   String?
  reportTemplateType ReportTemplateType          @default(TECHNICAL_SKILLS_REPORT)
  jobRoleId          String?
  skillFrameworkId   String?
  title              String
  description        String
  assessmentType     AssessmentType              @default(KNOWLEDGE_MCQ)
  moduleType         ModuleType                  @default(PSYCHOMETRIC)
  durationMinutes    Int
  maxAttempts        Int                         @default(1)
  startDateTime      DateTime?
  endDateTime        DateTime?
  randomizeQuestions Boolean                     @default(false)
  randomizeOptions   Boolean                     @default(false)
  /**
   * Freeform note from the admin, appended after the standard candidate
   * instructions (timer/navigation/how-to-answer/etc). Null/empty means
   * nothing extra is shown — the system defaults are never replaced.
   */
  customInstructions String?
  lifecycleStatus    AssessmentLifecycleStatus   @default(draft)
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @default(now()) @updatedAt
  tenant             Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  reportTemplate     ReportTemplate?             @relation(fields: [reportTemplateId], references: [id], onDelete: SetNull)
  jobRole            JobRole?                    @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  skillFramework     SkillFramework?             @relation(fields: [skillFrameworkId], references: [id], onDelete: SetNull)
  sections           AssessmentSection[]
  items              AssessmentItem[]
  triadGroups        TriadGroup[]
  caseStudies        CaseStudy[]
  assignments        AssessmentAssignment[]
  attempts           AssessmentAttempt[]
  results            AssessmentResult[]
  questions          AssessmentQuestion[]
  compositionItems   AssessmentCompositionItem[]
  programAssessments ProgramAssessment[]

  @@index([tenantId])
  @@index([assessmentType])
  @@index([moduleType])
  @@index([reportTemplateId])
  @@index([reportTemplateType])
  @@index([lifecycleStatus])
  @@index([jobRoleId])
  @@index([skillFrameworkId])
}

model AssessmentSection {
  id               String                      @id @default(cuid())
  assessmentId     String
  title            String
  description      String?
  displayOrder     Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @default(now()) @updatedAt
  assessment       Assessment                  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  items            AssessmentItem[]
  triadGroups      TriadGroup[]
  caseStudies      CaseStudy[]
  sectionScores    SectionScore[]
  compositionItems AssessmentCompositionItem[]

  @@unique([assessmentId, displayOrder])
  @@index([assessmentId])
}

model AssessmentItem {
  id              String                      @id @default(cuid())
  assessmentId    String?
  sectionId       String?
  caseStudyId     String?
  itemType        ItemType
  prompt          String
  helpText        String?
  displayOrder    Int                         @default(0)
  factor          String?
  trait           String?
  definition      String?
  polarity        Polarity?
  likertScaleId   String?
  attributeId     String?
  weightage       Float                       @default(1)
  skillId         String?
  subSkillId      String?
  imageUrl        String?
  audioUrl        String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @default(now()) @updatedAt
  assessment      Assessment?                 @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  section         AssessmentSection?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  caseStudy       CaseStudy?                  @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  likertScale     LikertScale?                @relation(fields: [likertScaleId], references: [id], onDelete: SetNull)
  attribute       Attribute?                  @relation(fields: [attributeId], references: [id], onDelete: SetNull)
  skill           Skill?                      @relation(fields: [skillId], references: [id], onDelete: SetNull)
  subSkill        SubSkill?                   @relation(fields: [subSkillId], references: [id], onDelete: SetNull)
  options         ItemOption[]
  responses       AttemptResponse[]
  compositionUses AssessmentCompositionItem[] @relation("CompositionLikertPoolItem")
  images          AssessmentItemImage[]

  @@index([assessmentId])
  @@index([sectionId])
  @@index([caseStudyId])
  @@index([itemType])
  @@index([factor, trait])
  @@index([skillId])
  @@index([subSkillId])
}

/// Up to 3 per AssessmentItem — the legacy single `AssessmentItem.imageUrl` column can't hold more than one, so multi-image questions (e.g. a graph-based quantitative item) use this table instead. `imageUrl` stays unused going forward.
model AssessmentItemImage {
  id           String         @id @default(cuid())
  itemId       String
  url          String
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  item         AssessmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model ItemOption {
  id           String            @id @default(cuid())
  itemId       String
  label        String
  value        String
  displayOrder Int               @default(0)
  isCorrect    Boolean           @default(false)
  scoreValue   Float?
  imageUrl     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  item         AssessmentItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  responses    AttemptResponse[]

  @@unique([itemId, displayOrder])
  @@index([itemId])
  @@index([isCorrect])
}

model LikertScale {
  id        String           @id @default(cuid())
  name      String
  minValue  Int              @default(1)
  maxValue  Int              @default(5)
  minLabel  String
  maxLabel  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  items     AssessmentItem[]

  @@unique([name, minValue, maxValue])
}

model TriadGroup {
  id              String                      @id @default(cuid())
  tenantId        String?
  triadGroupCode  String?
  assessmentId    String?
  sectionId       String?
  /// Set when this triad group is a Case Study sub-question rather than a standalone/pool item.
  caseStudyId     String?
  title           String
  displayOrder    Int                         @default(0)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @default(now()) @updatedAt
  tenant          Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assessment      Assessment?                 @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  section         AssessmentSection?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  caseStudy       CaseStudy?                  @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  statements      TriadStatement[]
  responses       AttemptResponse[]
  compositionUses AssessmentCompositionItem[] @relation("CompositionTriadPoolGroup")

  @@unique([tenantId, triadGroupCode])
  @@index([assessmentId])
  @@index([sectionId])
  @@index([caseStudyId])
  @@index([tenantId])
  @@index([triadGroupCode])
}

model CaseStudy {
  id              String                      @id @default(cuid())
  tenantId        String?
  assessmentId    String?
  sectionId       String?
  title           String
  passageText     String
  displayOrder    Int                         @default(0)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @default(now()) @updatedAt
  tenant          Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assessment      Assessment?                 @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  section         AssessmentSection?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subQuestions    AssessmentItem[]
  /// Triad-type sub-questions — parallel to `subQuestions` (MCQ/Likert), which stay on AssessmentItem.
  triadSubQuestions TriadGroup[]
  compositionUses AssessmentCompositionItem[] @relation("CompositionCaseStudyPool")

  @@index([assessmentId])
  @@index([sectionId])
  @@index([tenantId])
}

model AssessmentCompositionItem {
  id                     String            @id @default(cuid())
  assessmentId           String
  sectionId              String
  displayOrder           Int
  sourceAssessmentItemId String?
  sourceTriadGroupId     String?
  sourceCaseStudyId      String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @default(now()) @updatedAt
  assessment             Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section                AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sourceItem             AssessmentItem?   @relation("CompositionLikertPoolItem", fields: [sourceAssessmentItemId], references: [id], onDelete: Cascade)
  sourceTriad            TriadGroup?       @relation("CompositionTriadPoolGroup", fields: [sourceTriadGroupId], references: [id], onDelete: Cascade)
  sourceCaseStudy        CaseStudy?        @relation("CompositionCaseStudyPool", fields: [sourceCaseStudyId], references: [id], onDelete: Cascade)

  @@unique([sectionId, displayOrder])
  @@index([assessmentId])
  @@index([sourceAssessmentItemId])
  @@index([sourceTriadGroupId])
  @@index([sourceCaseStudyId])
}

model TriadStatement {
  id             String            @id @default(cuid())
  triadGroupId   String
  statementText  String
  displayOrder   Int               @default(0)
  factor         String
  trait          String
  definition     String
  polarity       Polarity
  attributeId    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  triadGroup     TriadGroup        @relation(fields: [triadGroupId], references: [id], onDelete: Cascade)
  attribute      Attribute?        @relation(fields: [attributeId], references: [id], onDelete: SetNull)
  mostResponses  AttemptResponse[] @relation("MostTriadStatement")
  leastResponses AttemptResponse[] @relation("LeastTriadStatement")

  @@unique([triadGroupId, displayOrder])
  @@index([triadGroupId])
  @@index([factor, trait])
}

model AssessmentAssignment {
  id                  String              @id @default(cuid())
  candidateId         String
  assessmentId        String
  accessToken         String              @unique
  status              AssignmentStatus    @default(assigned)
  assignedAt          DateTime            @default(now())
  completedAt         DateTime?
  expiresAt           DateTime?
  durationMinutes     Int?
  maxAttempts         Int?
  /// Set when this assignment is one module of a Program; null for direct/legacy assignments.
  programAssignmentId String?
  /// Mirrors ProgramAssessment.displayOrder for this module within its Program.
  programModuleOrder  Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  candidate           Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment          Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  programAssignment   ProgramAssignment?  @relation(fields: [programAssignmentId], references: [id], onDelete: SetNull)
  attempts            AssessmentAttempt[]
  result              AssessmentResult?

  @@index([candidateId])
  @@index([assessmentId])
  @@index([status])
  @@index([assignedAt])
  @@index([programAssignmentId])
}

model AssessmentAttempt {
  id                      String                @id @default(cuid())
  assignmentId            String?
  candidateId             String
  assessmentId            String
  status                  AttemptStatus         @default(NOT_STARTED)
  attemptNo               Int                   @default(1)
  startedAt               DateTime?
  submittedAt             DateTime?
  scoredAt                DateTime?
  /// Basic proctoring: false if candidate denied camera
  proctoringCameraGranted Boolean               @default(true)
  /// JPEG data URL or raw base64 snapshot at test start (optional)
  proctoringSnapshot      String?
  /// Final trust score (0–100) set when attempt is scored
  trustScore              Int?
  /// Auto-saved answers snapshot — written periodically during the test so progress survives interruptions
  progressData            Json?
  /// How the attempt was closed: NORMAL | TIMED_OUT | SIGNED_OUT | TAB_CLOSED | AUTO_SUBMITTED
  submissionType          String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  assignment              AssessmentAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  candidate               Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment              Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  responses               AttemptResponse[]
  scores                  AttemptScore[]
  traitScores             TraitScore[]
  sectionScores           SectionScore[]
  proctoringEvents        ProctoringEvent[]
  competencyScores        CompetencyScore[]
  skillScores             SkillScore[]

  @@unique([assignmentId, assessmentId, attemptNo])
  @@index([candidateId])
  @@index([assessmentId])
  @@index([status])
}

model ProctoringEvent {
  id        String              @id @default(cuid())
  attemptId String
  type      ProctoringEventType
  createdAt DateTime            @default(now())
  attempt   AssessmentAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model AttemptResponse {
  id                    String            @id @default(cuid())
  attemptId             String
  itemId                String?
  itemOptionId          String?
  triadGroupId          String?
  triadMostStatementId  String?
  triadLeastStatementId String?
  status                ResponseStatus    @default(ANSWERED)
  numericValue          Int?
  textValue             String?
  isCorrect             Boolean?
  rawScore              Float?
  scoredValue           Float?
  answeredAt            DateTime          @default(now())
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt
  attempt               AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  item                  AssessmentItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemOption            ItemOption?       @relation(fields: [itemOptionId], references: [id], onDelete: SetNull)
  triadGroup            TriadGroup?       @relation(fields: [triadGroupId], references: [id], onDelete: SetNull)
  triadMostStatement    TriadStatement?   @relation("MostTriadStatement", fields: [triadMostStatementId], references: [id], onDelete: SetNull)
  triadLeastStatement   TriadStatement?   @relation("LeastTriadStatement", fields: [triadLeastStatementId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@index([itemId])
  @@index([itemOptionId])
  @@index([triadGroupId])
  @@index([status])
}

model AttemptScore {
  id        String            @id @default(cuid())
  attemptId String
  scoreName String
  score     Float
  maxScore  Float?
  percent   Float?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, scoreName])
  @@index([attemptId])
}

model TraitScore {
  id         String            @id @default(cuid())
  attemptId  String
  factor     String
  trait      String
  definition String
  score      Float
  maxScore   Float?
  percent    Float?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt
  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, factor, trait])
  @@index([attemptId])
  @@index([factor, trait])
}

// ─── Competency Engine ───────────────────────────────────────────────────────

model Attribute {
  id          String   @id @default(cuid())
  tenantId    String?
  code        String
  name        String
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tenant            Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  competencyMaps    AttributeCompetencyMap[]
  bigFiveFactorMaps BigFiveFactorAttributeMap[]
  assessmentItems   AssessmentItem[]
  triadStatements   TriadStatement[]
  questions         Question[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ─── Big Five Factor Config ───────────────────────────────────────────────────

/// Per-factor scoring configuration for Big Five personality assessments.
/// `factor` must match the factor name stored on TraitScore/AssessmentItem rows.
model BigFiveFactorConfig {
  id             String   @id @default(cuid())
  tenantId       String?
  factor         String
  displayName    String?
  description    String?
  scoringFormula String   @default("WEIGHTED_AVERAGE")
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  tenant        Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  attributeMaps BigFiveFactorAttributeMap[]

  @@unique([tenantId, factor])
  @@index([tenantId])
}

model BigFiveFactorAttributeMap {
  id          String   @id @default(cuid())
  factorId    String
  attributeId String
  weight      Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  factor    BigFiveFactorConfig @relation(fields: [factorId], references: [id], onDelete: Cascade)
  attribute Attribute           @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([factorId, attributeId])
  @@index([factorId])
  @@index([attributeId])
}

model Competency {
  id                       String   @id @default(cuid())
  tenantId                 String?
  /// Null for legacy tenant-wide competencies (e.g. the original Big Five set).
  /// Set for competencies that belong to a specific Job Role framework.
  jobRoleId                String?
  domainId                 String?
  name                     String
  description              String?
  reportDescription        String?
  displayOrder             Int      @default(0)
  /// Scoring formula applied to mapped attribute scores.
  /// Supported values: "WEIGHTED_AVERAGE" | "SIMPLE_AVERAGE"
  /// Future values can be added without a schema migration.
  scoringFormula           String   @default("WEIGHTED_AVERAGE")
  /// Which band thresholds to apply to this competency's scaledScore.
  /// "GENERIC_5"  — Exceptional/Strong/Moderate/Developing/Low (legacy default)
  /// "MATURITY_4" — Developing/Intermediate/Proficient/Expert (job-role framework)
  proficiencyScale         String   @default("GENERIC_5")
  strengthStatement        String?
  developmentNeedStatement String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  tenant              Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  jobRole             JobRole?                 @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  domain              Domain?                  @relation(fields: [domainId], references: [id], onDelete: SetNull)
  attributeMaps       AttributeCompetencyMap[]
  scores              CompetencyScore[]
  bandContents        CompetencyBandContent[]
  developmentProjects DevelopmentProject[]

  @@unique([tenantId, jobRoleId, name])
  @@index([tenantId])
  @@index([jobRoleId])
  @@index([domainId])
}

model JobRole {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  slug         String?
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  domains        Domain[]
  competencies   Competency[]
  assessments    Assessment[]
  reportTemplate ReportTemplate?

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Domain {
  id           String   @id @default(cuid())
  tenantId     String?
  jobRoleId    String
  name         String
  description  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  jobRole      JobRole      @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  competencies Competency[]

  @@unique([jobRoleId, name])
  @@index([tenantId])
  @@index([jobRoleId])
}

model CompetencyBandContent {
  id                      String   @id @default(cuid())
  competencyId            String
  /// "Developing" | "Intermediate" | "Proficient" | "Expert"
  band                    String
  proficiencyDescription  String
  /// Newline-delimited bullet points.
  behaviouralImplications String
  /// Newline-delimited bullet points.
  watchOuts               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([competencyId, band])
  @@index([competencyId])
}

model DevelopmentProject {
  id           String   @id @default(cuid())
  competencyId String
  displayOrder Int      @default(0)
  title        String
  whatToDo     String
  howToDoIt    String
  evidence     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@index([competencyId])
}

model AttributeCompetencyMap {
  id           String   @id @default(cuid())
  attributeId  String
  competencyId String
  weight       Float    @default(1.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  attribute  Attribute  @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([attributeId, competencyId])
  @@index([attributeId])
  @@index([competencyId])
}

model CompetencyScore {
  id           String   @id @default(cuid())
  attemptId    String
  competencyId String
  rawScore     Float
  maxScore     Float
  scaledScore  Float
  percent      Float
  band         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  competency Competency        @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([attemptId, competencyId])
  @@index([attemptId])
  @@index([competencyId])
}

// ─── Skill Engine (Technical / Survey modules) ───────────────────────────────
// Parallel to Attribute/Competency/CompetencyScore above, used only by
// TECHNICAL and SURVEY module items. Psychometric items keep tagging
// Attribute/Competency exclusively — the two taxonomies never mix.

model Skill {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  description  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  tenant    Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  subSkills SubSkill[]
  items     AssessmentItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model SubSkill {
  id           String   @id @default(cuid())
  skillId      String
  name         String
  description  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  skill               Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  items               AssessmentItem[]
  skillCompetencyMaps SkillCompetencyMap[]

  @@unique([skillId, name])
  @@index([skillId])
}

model SkillScore {
  id                String   @id @default(cuid())
  attemptId         String
  skillCompetencyId String
  rawScore          Float
  maxScore          Float
  scaledScore       Float
  percent           Float
  band              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  skillCompetency SkillCompetency   @relation(fields: [skillCompetencyId], references: [id], onDelete: Cascade)

  @@unique([attemptId, skillCompetencyId])
  @@index([attemptId])
  @@index([skillCompetencyId])
}

// ─── Skill Framework (Technical module's Job-Role equivalent) ───────────────
// Full mirror of JobRole/Domain/Competency/AttributeCompetencyMap/
// CompetencyBandContent/DevelopmentProject above, rooted in Skill/SubSkill
// instead of Attribute. SubSkill is the measurable leaf (like Attribute);
// Skill is the loose category (like Attribute.category).

model SkillFramework {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  slug         String?
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  skillDomains      SkillDomain[]
  skillCompetencies SkillCompetency[]
  assessments       Assessment[]
  reportTemplate    ReportTemplate?

  @@unique([tenantId, name])
  @@index([tenantId])
}

model SkillDomain {
  id               String   @id @default(cuid())
  tenantId         String?
  skillFrameworkId String
  name             String
  description      String?
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  skillFramework    SkillFramework    @relation(fields: [skillFrameworkId], references: [id], onDelete: Cascade)
  skillCompetencies SkillCompetency[]

  @@unique([skillFrameworkId, name])
  @@index([tenantId])
  @@index([skillFrameworkId])
}

model SkillCompetency {
  id                       String   @id @default(cuid())
  tenantId                 String?
  /// Null for a domainless skill competency within its framework.
  skillFrameworkId         String?
  skillDomainId            String?
  name                     String
  description              String?
  reportDescription        String?
  displayOrder             Int      @default(0)
  /// Same convention as Competency.scoringFormula.
  scoringFormula           String   @default("WEIGHTED_AVERAGE")
  /// Same convention as Competency.proficiencyScale.
  proficiencyScale         String   @default("GENERIC_5")
  strengthStatement        String?
  developmentNeedStatement String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  tenant              Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  skillFramework      SkillFramework?              @relation(fields: [skillFrameworkId], references: [id], onDelete: Cascade)
  skillDomain         SkillDomain?                 @relation(fields: [skillDomainId], references: [id], onDelete: SetNull)
  subSkillMaps        SkillCompetencyMap[]
  scores              SkillScore[]
  bandContents        SkillCompetencyBandContent[]
  developmentProjects SkillDevelopmentProject[]

  @@unique([tenantId, skillFrameworkId, name])
  @@index([tenantId])
  @@index([skillFrameworkId])
  @@index([skillDomainId])
}

model SkillCompetencyMap {
  id                String   @id @default(cuid())
  subSkillId        String
  skillCompetencyId String
  weight            Float    @default(1.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  subSkill        SubSkill        @relation(fields: [subSkillId], references: [id], onDelete: Cascade)
  skillCompetency SkillCompetency @relation(fields: [skillCompetencyId], references: [id], onDelete: Cascade)

  @@unique([subSkillId, skillCompetencyId])
  @@index([subSkillId])
  @@index([skillCompetencyId])
}

model SkillCompetencyBandContent {
  id                      String   @id @default(cuid())
  skillCompetencyId       String
  /// "Developing" | "Intermediate" | "Proficient" | "Expert"
  band                    String
  proficiencyDescription  String
  /// Newline-delimited bullet points.
  behaviouralImplications String
  /// Newline-delimited bullet points.
  watchOuts               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  skillCompetency SkillCompetency @relation(fields: [skillCompetencyId], references: [id], onDelete: Cascade)

  @@unique([skillCompetencyId, band])
  @@index([skillCompetencyId])
}

model SkillDevelopmentProject {
  id                String   @id @default(cuid())
  skillCompetencyId String
  displayOrder      Int      @default(0)
  title             String
  whatToDo          String
  howToDoIt         String
  evidence          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  skillCompetency SkillCompetency @relation(fields: [skillCompetencyId], references: [id], onDelete: Cascade)

  @@index([skillCompetencyId])
}

model SectionScore {
  id                  String             @id @default(cuid())
  assessmentResultId  String?
  assessmentAttemptId String?
  sectionId           String?
  sectionName         String
  score               Float
  maxScore            Float
  summary             String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  assessmentResult    AssessmentResult?  @relation(fields: [assessmentResultId], references: [id], onDelete: Cascade)
  assessmentAttempt   AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  section             AssessmentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([assessmentResultId])
  @@index([assessmentAttemptId])
  @@index([sectionId])
}

model ReportTemplate {
  id               String          @id @default(cuid())
  tenantId         String?
  /// Set when this template is owned by a Job Role framework rather than
  /// picked directly by assessmentType.
  jobRoleId        String?         @unique
  /// Set when this template is owned by a Skill Framework instead.
  skillFrameworkId String?         @unique
  name             String
  assessmentType   AssessmentType
  headerTitle      String
  introduction     String
  footerText       String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  tenant           Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  jobRole          JobRole?        @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  skillFramework   SkillFramework? @relation(fields: [skillFrameworkId], references: [id], onDelete: SetNull)
  assessments      Assessment[]

  @@unique([tenantId, name, assessmentType])
  @@index([tenantId])
  @@index([assessmentType])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String?
  /// Identifies which outgoing mail this row overrides, e.g. "assignment_invite".
  key       String
  subject   String
  bodyText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model ImportJob {
  id          String           @id @default(cuid())
  tenantId    String?
  importType  ImportType
  status      ImportJobStatus  @default(PROCESSING)
  fileName    String
  batchName   String?
  totalRows   Int              @default(0)
  successRows Int              @default(0)
  failedRows  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  rowErrors   ImportRowError[]

  @@index([tenantId])
  @@index([importType])
  @@index([status])
  @@index([createdAt])
}

model ImportRowError {
  id          String    @id @default(cuid())
  importJobId String
  rowNumber   Int
  message     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([rowNumber])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// Legacy MCQ compatibility models used by the current demo UI.
model Question {
  id            String               @id @default(cuid())
  tenantId      String?
  section       String
  category      String
  questionText  String
  option1       String
  option2       String
  option3       String
  option4       String
  correctOption Int
  explanation   String
  attributeId   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt
  tenant        Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  attribute     Attribute?           @relation(fields: [attributeId], references: [id], onDelete: SetNull)
  responses     QuestionResponse[]
  assessments   AssessmentQuestion[]

  @@index([tenantId])
  @@index([section])
  @@index([category])
  @@index([attributeId])
}

model AssessmentQuestion {
  id           String     @id @default(cuid())
  assessmentId String
  questionId   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([questionId])
}

model AssessmentResult {
  id                String                @id @default(cuid())
  candidateId       String
  assessmentId      String?
  assignmentId      String?               @unique
  assessmentName    String
  completedAt       DateTime
  overallScore      Float
  strengths         Json
  areasOfConcern    Json
  /// Set once the Program this assignment belongs to has every module scored; null until then.
  programResultId   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt
  candidate         Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment        Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  assignment        AssessmentAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  programResult     ProgramResult?        @relation(fields: [programResultId], references: [id], onDelete: SetNull)
  sectionScores     SectionScore[]
  questionResponses QuestionResponse[]

  @@index([candidateId])
  @@index([assessmentId])
  @@index([completedAt])
  @@index([programResultId])
}

model QuestionResponse {
  id                 String           @id @default(cuid())
  assessmentResultId String
  questionId         String
  selectedOption     Int
  isCorrect          Boolean
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  assessmentResult   AssessmentResult @relation(fields: [assessmentResultId], references: [id], onDelete: Cascade)
  question           Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([assessmentResultId])
  @@index([questionId])
}

// ─── Program (candidate-facing container of one or more Modules) ────────────
// A "Module" is not a new entity — it's an Assessment with a moduleType,
// attached into a Program via ProgramAssessment. Program : ProgramAssignment
// mirrors the existing Assessment : AssessmentAssignment split one level up.
// Every AssessmentAssignment/AssessmentAttempt/AssessmentResult keeps meaning
// exactly what it means today; these tables only ever wrap them.

model Program {
  id              String                 @id @default(cuid())
  tenantId        String?
  title           String
  description     String?
  compositionType ProgramCompositionType
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt

  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assessments ProgramAssessment[]
  assignments ProgramAssignment[]

  @@index([tenantId])
  @@index([compositionType])
}

model ProgramAssessment {
  id           String   @id @default(cuid())
  programId    String
  assessmentId String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  program    Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([programId, assessmentId])
  @@unique([programId, displayOrder])
  @@index([assessmentId])
}

model ProgramAssignment {
  id          String           @id @default(cuid())
  programId   String
  candidateId String
  accessToken String           @unique
  status      AssignmentStatus @default(assigned)
  assignedAt  DateTime         @default(now())
  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  program               Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  candidate             Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentAssignments AssessmentAssignment[]
  result                ProgramResult?

  @@index([programId])
  @@index([candidateId])
  @@index([status])
}

model ProgramResult {
  id                  String   @id @default(cuid())
  programAssignmentId String   @unique
  candidateId         String
  completedAt         DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  programAssignment ProgramAssignment  @relation(fields: [programAssignmentId], references: [id], onDelete: Cascade)
  candidate         Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentResults AssessmentResult[]

  @@index([candidateId])
}
