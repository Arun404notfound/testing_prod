DATABASE_URL="file:./dev.db"

# Base URL used to build candidate assignment links in emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Brevo (Sendinblue) transactional email — https://app.brevo.com/settings/keys/api
# Assignment emails are skipped (logged, non-fatal) if BREVO_API_KEY is unset
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@example.com"
BREVO_SENDER_NAME="AptIQ Assessments"

# Secret used to sign admin session JWTs (32+ chars)
AUTH_SECRET=""
